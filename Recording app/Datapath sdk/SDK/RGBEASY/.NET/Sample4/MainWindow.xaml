<Window x:Name="window" x:Class="Sample4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sample4"
        xmlns:wf="clr-namespace:System.Windows.Forms;assembly=System.Windows.Forms"
        mc:Ignorable="d"
        Title="Sample4" Height="600" Width="800" Closing="MainWindow_Closing">
   <DockPanel>
      <Menu DockPanel.Dock="Top" Height="22" FontSize="12">
         <MenuItem Header="_File">
            <MenuItem Header="_Audio" Click="MenuItem_Audio" />
            <Separator/>
            <MenuItem Header="_Exit" Click="MenuItem_Exit" />
         </MenuItem>
      </Menu>
      <Grid DockPanel.Dock="Bottom" x:Name="grid" >
         <WindowsFormsHost  Width="{Binding ActualWidth, ElementName=grid, Mode=OneWay}" Height="{Binding ActualHeight, ElementName=grid, Mode=OneWay}">
            <wf:PictureBox x:Name="rgbControl" Dock="Fill" />
         </WindowsFormsHost>
      </Grid>
   </DockPanel>
</Window>
