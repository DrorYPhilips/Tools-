<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Video Mask: hide areas of a video with blur / pixelate / black boxes.
    Targets .NET Framework 4.8, which is part of Windows 10 and 11.
    The exe is small and runs without installing anything.
    It needs ffmpeg.exe in the same folder (or on PATH).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>MaskVideo</AssemblyName>
    <RootNamespace>MaskVideo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Video Mask</Product>
    <AssemblyTitle>Video Mask - hide areas of a video</AssemblyTitle>
    <Copyright>2026</Copyright>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAppConfigFile>false</GenerateAppConfigFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
